# Variáveis de ambiente do frontend - Comandas Stuani
# Copie este arquivo para `.env` e ajuste os valores conforme seu ambiente.
# O prefixo VITE_ é obrigatório para expor a variável ao frontend (Vite).

# Base usada pelo axios. Use /api para passar pelo proxy do Vite (evita
# problemas de CORS e de certificado SSL auto-assinado da API em HTTPS).
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000

# Alvo do proxy do Vite (desenvolvimento). A API roda em HTTPS na 8443 (Docker).
VITE_PROXY_TARGET=https://localhost:8443
# false = não valida o certificado SSL/TLS (certificado auto-assinado em dev)
VITE_PROXY_SECURE=false
